#{
    grafika: okno, rysowanie, wejście i dźwięk dla gier 2D na raylib 5.5.

    Każda operacja zwraca status (OK albo jeden z kodów poniżej); operacje tworzące
    zasób zwracają krotkę (status, uchwyt). Uchwyt jest ważny do zwolnienia zasobu:
    po zwolnieniu ta sama liczba daje HANDLE. Tekst i ścieżki muszą być poprawnym UTF-8
    bez znaku NUL, najwyżej 4096 bajtów. Kolory są w formacie 0xRRGGBBAA.

    Okno i jego zasoby (tekstury, fonty) działają tylko przy otwartym oknie, a rysowanie
    tylko między frameBegin i frameEnd. Dźwięki wymagają audioOpen.
#}
import core.builtins as builtins;
import core.containers.*;

const OK: i32 = 0i32;
const STATE: i32 = 1i32;
const VALUE: i32 = 2i32;
const HANDLE: i32 = 3i32;
const TYPE: i32 = 4i32;
const LOAD: i32 = 5i32;
const BUSY: i32 = 6i32;
const UTF8: i32 = 7i32;
const IO: i32 = 8i32;
const LIMIT: i32 = 9i32;
const BACKEND: i32 = 10i32;

# Klawisze w maskach InputState: A=1, SPACE=2, D=4, P=8, N=16, ESCAPE=32.
# Pozostałe klawisze sprawdzają keyDown, keyPressed i keyReleased ze stałymi KEY_*.
const KEY_MASK_A: i32 = 1i32;
const KEY_MASK_SPACE: i32 = 2i32;
const KEY_MASK_D: i32 = 4i32;
const KEY_MASK_P: i32 = 8i32;
const KEY_MASK_N: i32 = 16i32;
const KEY_MASK_ESCAPE: i32 = 32i32;

#{
    Kody klawiszy dla keyDown, keyPressed i keyReleased (wartości z raylib.h).
    Litery i cyfry mają kody ASCII wielkich liter i cyfr, np. KEY_W = 87.
#}
const KEY_SPACE: i32 = 32i32;
const KEY_ESCAPE: i32 = 256i32;
const KEY_ENTER: i32 = 257i32;
const KEY_TAB: i32 = 258i32;
const KEY_BACKSPACE: i32 = 259i32;
const KEY_RIGHT: i32 = 262i32;
const KEY_LEFT: i32 = 263i32;
const KEY_DOWN: i32 = 264i32;
const KEY_UP: i32 = 265i32;
const KEY_LEFT_SHIFT: i32 = 340i32;
const KEY_LEFT_CONTROL: i32 = 341i32;
const KEY_RIGHT_SHIFT: i32 = 344i32;
const KEY_RIGHT_CONTROL: i32 = 345i32;
const KEY_ZERO: i32 = 48i32;
const KEY_ONE: i32 = 49i32;
const KEY_TWO: i32 = 50i32;
const KEY_THREE: i32 = 51i32;
const KEY_FOUR: i32 = 52i32;
const KEY_FIVE: i32 = 53i32;
const KEY_SIX: i32 = 54i32;
const KEY_SEVEN: i32 = 55i32;
const KEY_EIGHT: i32 = 56i32;
const KEY_NINE: i32 = 57i32;
const KEY_A: i32 = 65i32;
const KEY_B: i32 = 66i32;
const KEY_C: i32 = 67i32;
const KEY_D: i32 = 68i32;
const KEY_E: i32 = 69i32;
const KEY_F: i32 = 70i32;
const KEY_G: i32 = 71i32;
const KEY_H: i32 = 72i32;
const KEY_I: i32 = 73i32;
const KEY_J: i32 = 74i32;
const KEY_K: i32 = 75i32;
const KEY_L: i32 = 76i32;
const KEY_M: i32 = 77i32;
const KEY_N: i32 = 78i32;
const KEY_O: i32 = 79i32;
const KEY_P: i32 = 80i32;
const KEY_Q: i32 = 81i32;
const KEY_R: i32 = 82i32;
const KEY_S: i32 = 83i32;
const KEY_T: i32 = 84i32;
const KEY_U: i32 = 85i32;
const KEY_V: i32 = 86i32;
const KEY_W: i32 = 87i32;
const KEY_X: i32 = 88i32;
const KEY_Y: i32 = 89i32;
const KEY_Z: i32 = 90i32;

#{ Przyciski myszy w maskach InputState.mouseDown, mousePressed i mouseReleased. #}
const MOUSE_LEFT: i32 = 1i32;
const MOUSE_RIGHT: i32 = 2i32;
const MOUSE_MIDDLE: i32 = 4i32;

#{ Gotowe kolory w formacie 0xRRGGBBAA (te same co w raylib). #}
const WHITE: u32 = 0xffffffffu32;
const BLACK: u32 = 0x000000ffu32;
const GRAY: u32 = 0x828282ffu32;
const DARKGRAY: u32 = 0x505050ffu32;
const RED: u32 = 0xe62937ffu32;
const ORANGE: u32 = 0xffa100ffu32;
const YELLOW: u32 = 0xfdf900ffu32;
const GREEN: u32 = 0x00e430ffu32;
const DARKGREEN: u32 = 0x00752cffu32;
const SKYBLUE: u32 = 0x66bfffffu32;
const BLUE: u32 = 0x0079f1ffu32;
const PURPLE: u32 = 0xc87affffu32;
const BROWN: u32 = 0x7f6a4fffu32;

# Hack: Duckling has no null cptr literal and rejects integer-to-pointer casts
# (`0u64 as ptr T` is an invalid cast), so we read a zero u64 through a pointer
# to a cptr. Note: we could probably drop this once the language gets a null literal.
template(T: type)
fun nullPointer() -> cptr T = {
    var zero: u64 = 0u64;
    return (&zero as cptr (cptr T))[0];
}

extern("C") {
    class Color { r: u8 = 0u8; g: u8 = 0u8; b: u8 = 0u8; a: u8 = 0u8; }
    class Vector2 { x: f32 = 0.0f32; y: f32 = 0.0f32; }
    class Rectangle { x: f32 = 0.0f32; y: f32 = 0.0f32; width: f32 = 0.0f32; height: f32 = 0.0f32; }
    class Image { data: cptr u8 = nullPointer[u8](); width: i32 = 0i32; height: i32 = 0i32; mipmaps: i32 = 0i32; format: i32 = 0i32; }
    class Texture { id: u32 = 0u32; width: i32 = 0i32; height: i32 = 0i32; mipmaps: i32 = 0i32; format: i32 = 0i32; }
    class RenderTexture { id: u32 = 0u32; texture: Texture = Texture(); depth: Texture = Texture(); }
    class GlyphInfo { value: i32 = 0i32; offsetX: i32 = 0i32; offsetY: i32 = 0i32; advanceX: i32 = 0i32; image: Image = Image(); }
    class Font {
        baseSize: i32 = 0i32; glyphCount: i32 = 0i32; glyphPadding: i32 = 0i32; texture: Texture = Texture();
        recs: cptr Rectangle = nullPointer[Rectangle](); glyphs: cptr GlyphInfo = nullPointer[GlyphInfo]();
    }
    class AudioStream { buffer: cptr u8 = nullPointer[u8](); processor: cptr u8 = nullPointer[u8](); sampleRate: u32 = 0u32; sampleSize: u32 = 0u32; channels: u32 = 0u32; }
    class Sound { stream: AudioStream = AudioStream(); frameCount: u32 = 0u32; }
    class Music { stream: AudioStream = AudioStream(); frameCount: u32 = 0u32; looping: bool = false; ctxType: i32 = 0i32; ctxData: cptr u8 = nullPointer[u8](); }
    class Timespec { seconds: i64 = 0i64; nanoseconds: i64 = 0i64; }
    class PollFd { fd: i32 = 0i32; events: i16 = 0i16; revents: i16 = 0i16; }

    namespace raylib {
        fundecl SetTraceLogLevel(level: i32) -> ();
        fundecl SetTargetFPS(fps: i32) -> ();
        fundecl GetTime() -> f64;
        fundecl InitWindow(width: i32, height: i32, title: cptr char) -> ();
        fundecl IsWindowReady() -> bool;
        fundecl CloseWindow() -> ();
        fundecl WindowShouldClose() -> bool;
        fundecl SetExitKey(key: i32) -> ();
        fundecl GetScreenWidth() -> i32;
        fundecl GetScreenHeight() -> i32;
        fundecl SetMouseScale(x: f32, y: f32) -> ();
        fundecl BeginDrawing() -> ();
        fundecl EndDrawing() -> ();
        fundecl BeginTextureMode(target: RenderTexture) -> ();
        fundecl EndTextureMode() -> ();
        fundecl ClearBackground(color: Color) -> ();
        fundecl DrawRectangle(x: i32, y: i32, width: i32, height: i32, color: Color) -> ();
        fundecl DrawCircle(x: i32, y: i32, radius: f32, color: Color) -> ();
        fundecl DrawTriangle(a: Vector2, b: Vector2, c: Vector2, color: Color) -> ();
        fundecl DrawLineEx(start: Vector2, end: Vector2, thickness: f32, color: Color) -> ();
        fundecl DrawRectangleLinesEx(rectangle: Rectangle, thickness: f32, color: Color) -> ();
        fundecl DrawRectanglePro(rectangle: Rectangle, origin: Vector2, rotation: f32, color: Color) -> ();
        fundecl DrawCircleLines(x: i32, y: i32, radius: f32, color: Color) -> ();
        fundecl DrawText(text: cptr char, x: i32, y: i32, size: i32, color: Color) -> ();
        fundecl MeasureText(text: cptr char, size: i32) -> i32;
        fundecl GetFrameTime() -> f32;
        fundecl GetFPS() -> i32;
        fundecl GetRandomValue(min: i32, max: i32) -> i32;
        fundecl SetRandomSeed(seed: u32) -> ();
        fundecl DrawTexture(texture: Texture, x: i32, y: i32, tint: Color) -> ();
        fundecl DrawTexturePro(texture: Texture, source: Rectangle, dest: Rectangle, origin: Vector2, rotation: f32, tint: Color) -> ();
        fundecl DrawTextEx(font: Font, text: cptr char, position: Vector2, size: f32, spacing: f32, tint: Color) -> ();
        fundecl MeasureTextEx(font: Font, text: cptr char, size: f32, spacing: f32) -> Vector2;
        fundecl LoadRenderTexture(width: i32, height: i32) -> RenderTexture;
        fundecl IsRenderTextureValid(target: RenderTexture) -> bool;
        fundecl UnloadRenderTexture(target: RenderTexture) -> ();
        fundecl SetTextureFilter(texture: Texture, filter: i32) -> ();
        fundecl LoadTexture(path: cptr char) -> Texture;
        fundecl IsTextureValid(texture: Texture) -> bool;
        fundecl UnloadTexture(texture: Texture) -> ();
        fundecl LoadImageFromTexture(texture: Texture) -> Image;
        fundecl LoadImageFromScreen() -> Image;
        fundecl ImageFlipVertical(image: cptr Image) -> ();
        fundecl IsImageValid(image: Image) -> bool;
        fundecl ExportImage(image: Image, path: cptr char) -> bool;
        fundecl UnloadImage(image: Image) -> ();
        fundecl rlDrawRenderBatchActive() -> ();
        fundecl LoadFontEx(path: cptr char, size: i32, codepoints: cptr i32, count: i32) -> Font;
        fundecl GetFontDefault() -> Font;
        fundecl IsFontValid(font: Font) -> bool;
        fundecl UnloadFont(font: Font) -> ();
        fundecl GetKeyPressed() -> i32;
        fundecl GetCharPressed() -> i32;
        fundecl IsKeyDown(key: i32) -> bool;
        fundecl IsMouseButtonDown(button: i32) -> bool;
        fundecl GetMouseX() -> i32;
