    }
    namespace libc {
        fundecl getenv(name: cptr char) -> cptr char;
        fundecl strcmp(a: cptr char, b: cptr char) -> i32;
        fundecl fflush(stream: u64) -> i32;
        fundecl clock_gettime(clock: i32, value: cptr Timespec) -> i32;
        fundecl nanosleep(request: cptr Timespec, remaining: cptr Timespec) -> i32;
        fundecl poll(fds: cptr PollFd, count: u64, timeout: i32) -> i32;
